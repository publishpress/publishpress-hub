{
	"folders": [
		{
			"path": "."
		}
	],
    "settings": {
        "githubIssues.queries": [
            {
                "label": "My Issues",
                "query": "is:open assignee:${user} repo:publishpress/publishpress-hub",
                "groupBy": [
                    "milestone"
                ]
            },
            {
                "label": "Created Issues",
                "query": "author:${user} state:open repo:publishpress/publishpress-hub sort:created-desc"
            },
            {
                "label": "Recent Issues",
                "query": "state:open repo:publishpress/publishpress-hub sort:updated-desc"
            }
        ],
    },
	"launch": {
        "configurations": [
            {
                "name": "Xdebug on wp_dev (dev-workspace)",
                "type": "php",
                "request": "launch",
                "port": 9003,
                "pathMappings": {
                    "/var/www/html": "${workspaceFolder}/dev-workspace/.cache/wp_dev",
                    "/var/www/html/wp-content/plugins/dummy-plugin-1": "${workspaceFolder}/tests/plugins/dummy-plugin-1",
					"/var/www/html/wp-content/plugins/dummy-plugin-2": "${workspaceFolder}/tests/plugins/dummy-plugin-2",
                    "/var/www/html/wp-content/plugins/publishpress-hub": "${workspaceFolder}"
                },
                "hostname": "0.0.0.0"
            }
        ]
    }
}
