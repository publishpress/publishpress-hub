{
	"folders": [
		{
			"path": "."
		}
	],
    "settings": {
        "githubIssues.queries": [
            {
                "label": "My Issues",
                "query": "is:open assignee:${user} repo:publishpress/publishpress-hub",
                "groupBy": [
                    "milestone"
                ]
            },
            {
                "label": "Created Issues",
                "query": "author:${user} state:open repo:publishpress/publishpress-hub sort:created-desc"
            },
            {
                "label": "Recent Issues",
                "query": "state:open repo:publishpress/publishpress-hub sort:updated-desc"
            }
        ],
        "remote.SSH.defaultExtensions": [
            "ms-vscode.php-debug"
        ],
        "php.debug.ideKey": "vsc",
        "php.validate.enable": true,
        "php.suggest.basic": false,
        "files.associations": {
            "*.php": "php"
        },
        "remote.SSH.remotePlatform": "linux",
        "remote.SSH.connectTimeout": 60
    },
	"launch": {
        "configurations": [
            {
                "name": "Xdebug on wp_dev (dev-workspace)",
                "type": "php",
                "request": "launch",
                "port": 9003,
                "runtimeArgs": [
                    "-dxdebug.start_with_request=yes"
                ],
                "pathMappings": {
                    "/var/www/html/wp-content/plugins/publishpress-hub": "/var/git-repos/publishpress/publishpress-hub",
                    "/var/www/html": "/var/git-repos/publishpress/publishpress-hub/dev-workspace/.cache/dev-wp/html",
                },
                "hostname": "0.0.0.0"
            }
        ]
    }
}
