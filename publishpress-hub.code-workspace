{
	"folders": [
		{
			"path": "."
		}
	],
    "settings": {
        "githubIssues.queries": [
            {
                "label": "My Issues",
                "query": "is:open assignee:${user} repo:publishpress/publishpress-hub",
                "groupBy": [
                    "milestone"
                ]
            },
            {
                "label": "Created Issues",
                "query": "author:${user} state:open repo:publishpress/publishpress-hub sort:created-desc"
            },
            {
                "label": "Recent Issues",
                "query": "state:open repo:publishpress/publishpress-hub sort:updated-desc"
            }
        ],
        "remote.SSH.defaultExtensions": [
            "ms-vscode.php-debug"
        ],
        "php.debug.ideKey": "VSCODE",
        "php.validate.enable": true,
        "php.suggest.basic": false,
        "files.associations": {
            "*.php": "php"
        },
        "remote.SSH.remotePlatform": "linux",
        "remote.SSH.connectTimeout": 60
    },
	"launch": {
        "configurations": [
            {
				"name": "Listen for Xdebug (LocalWP)",
				"type": "php",
				"request": "launch",
				"port": 9003,
				"pathMappings": {
					"/Users/andersonmartins/LocalSites/hub-dev/app/public/wp-content/plugins/publishpress-hub": "${workspaceFolder}"
				},
				"log": true,
				"xdebugSettings": {
					"max_data": 65535,
					"show_hidden": 1,
					"max_children": 100,
					"max_depth": 5
				}
			}
        ]
    }
}
