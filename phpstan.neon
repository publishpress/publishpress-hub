parameters:
    level: 8
    paths:
        - ./src
    excludePaths:
        - /lib
        - /vendor
        - .github
        - .vscode
        - .idea
        - tests
        - tests-old
        - .wordpress-org
        - bin
        - ./dist
        - ./languages
        - node_modules
        - dev-workspace
        - cache
        - .cache
        - ./src/Versions.php
        - ./src/include.php
rules:
    - Spatie\Ray\PHPStan\RemainingRayCallRule
