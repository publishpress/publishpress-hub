msgstr "Bạn không thể liệt kê người dùng."

#: src/Application/Service/Mcp/WordPressLookupService.php:66
msgid "Provide either a user ID or an exact username."
msgstr "Cung cấp một ID người dùng hoặc một tên người dùng chính xác."

#: src/Application/Service/Mcp/WordPressLookupService.php:71
msgid "No matching user belongs to this site."
msgstr "Không có người dùng nào phù hợp thuộc về trang này."

#: src/Application/Service/Mcp/WordPressLookupService.php:74
