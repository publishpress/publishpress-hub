msgstr "Loại bài viết này không hỗ trợ tìm kiếm nội dung."

#: src/Application/Service/Mcp/WordPressWriteService.php:28
msgid ""
"MCP tools cannot create users with administrator-level access. Use the "
"WordPress Users screen for this change."
msgstr ""
"Công cụ MCP không thể tạo người dùng với quyền truy cập cấp quản trị viên. "
"Sử dụng màn hình Người dùng WordPress cho thay đổi này."

#: src/Application/Service/Mcp/WordPressWriteService.php:71
msgid "Provide at least one content field to update."
msgstr "Cung cấp ít nhất một trường nội dung để cập nhật."

#: src/Application/Service/Mcp/WordPressWriteService.php:86
msgid "Choose an existing REST-enabled post type."
msgstr "Chọn một loại bài viết có hỗ trợ REST đã tồn tại."

#: src/Application/Service/Mcp/WordPressWriteService.php:90
