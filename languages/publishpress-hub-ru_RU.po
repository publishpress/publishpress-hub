msgstr ""
"Инструменты MCP не могут создавать пользователей с доступом уровня "
"администратора. Используйте экран пользователей WordPress для этого "
"изменения."

#: src/Application/Service/Mcp/WordPressWriteService.php:71
msgid "Provide at least one content field to update."
msgstr "Укажите хотя бы одно поле контента для обновления."

#: src/Application/Service/Mcp/WordPressWriteService.php:86
msgid "Choose an existing REST-enabled post type."
msgstr "Выберите существующий тип записи с поддержкой REST."

