msgstr ""
"لا يمكن لأدوات MCP إنشاء مستخدمين بإمكانية وصول على مستوى المدير. استخدم "
"شاشة مستخدمي WordPress لهذا التغيير."

#: src/Application/Service/Mcp/WordPressWriteService.php:71
msgid "Provide at least one content field to update."
msgstr "قدم على الأقل حقل محتوى واحد للتحديث."

#: src/Application/Service/Mcp/WordPressWriteService.php:86
msgid "Choose an existing REST-enabled post type."
msgstr "اختر نوع منشور موجود يدعم REST."

#: src/Application/Service/Mcp/WordPressWriteService.php:90
