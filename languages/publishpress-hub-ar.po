msgstr "لا يمكنك فحص هذا المستخدم."

#: src/Application/Service/Mcp/WordPressLookupService.php:92
msgid "Choose a REST-enabled post type."
msgstr "اختر نوع منشور يدعم REST."

#: src/Application/Service/Mcp/WordPressLookupService.php:96
