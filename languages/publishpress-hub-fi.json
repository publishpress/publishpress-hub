{"domain":"publishpress-hub","locale_data":{"messages":{"":{"domain":"publishpress-hub","lang":"fi","plural_forms":"nplurals=2; plural=(n != 1);"},"PublishPress Hub":["PublishPress Hub"],"Centralized management hub for all PublishPress plugins - install, update, and manage licenses from one dashboard.":["Keskitetty hallintakeskus kaikille PublishPress-plugineille - asenna, päivitä ja hallitse lisenssejä yhdestä ohjauspaneelista."],"PublishPress":["PublishPress"],"https://publishpress.com":["https://publishpress.com"],"Please wait while we load the components showcase...":["Ole hyvä ja odota, kun lataamme komponenttien esittelyn..."],"Please wait while we load the plugins dashboard...":["Ole hyvä ja odota, kun lataamme lisäosien kojelaudan..."],"Settings":["Asetukset"],"Please wait while we load the settings page...":["Ole hyvä ja odota, kun lataamme asetussivua..."],"You do not have sufficient permissions to access this page.":["Sinulla ei ole riittäviä oikeuksia tämän sivun käyttämiseen."],"Welcome":["Tervetuloa"],"Please wait while we load the welcome page...":["Ole hyvä ja odota, kun lataamme tervetulosivua..."],"Warning: The license for %1$s has expired. %2$s":["Varoitus: %1$s-lisäosan lisenssi on vanhentunut. %2$s"],"Manage licenses":["Hallinnoi lisenssejä"],"Warning: %1$d plugin(s) have expired licenses: %2$s. %3$s":["Varoitus: %1$d lisäosalla on vanhentuneet lisenssit: %2$s. %3$s"],"Object must be loaded before initializing.":["Objekti on ladattava ennen alustamista."],"No license key found":["Lisenssiavainta ei löytynyt"],"Free plugin not set for plugin family: %s":["Ilmainen lisäosa ei ole asetettu lisäosaperheelle: %s"],"Pro plugin not set for plugin family: %s":["Pro-lisäosa ei ole asetettu lisäosaperheelle: %s"],"License activation error. Please try again later or contact support for help.":["Lisenssipalvelimen virhe. Ole hyvä ja yritä uudelleen myöhemmin tai ota yhteyttä tukeen saadaksesi apua."],"License deactivation error. Please try again later or co