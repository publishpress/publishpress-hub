msgid ""
"License activation limit reached. Please contact support to upgrade or "
"deactivate on another site."
msgstr ""
"Limiet voor licentieactivatie bereikt. Neem contact op met de ondersteuning "
"om te upgraden of op een andere site te deactiveren."

#: src/Domain/Plugin/Exception/LicenseNotActivableException.php:30
msgid "This license cannot be activated. Please contact support for help."
msgstr ""
"Deze licentie kan niet worden geactiveerd. Neem contact op met de "
"ondersteuning voor hulp."

