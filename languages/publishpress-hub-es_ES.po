#: src/Domain/Plugin/Exception/LicenseActivationException.php:28
msgid ""
"License activation error. Please try again later or contact support for help."
msgstr ""
"Error de activación de la licencia. Por favor, inténtalo de nuevo más tarde "
"o contácta con soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/LicenseDeactivationException.php:28
msgid ""
"License deactivation error. Please try again later or contact support for "
"help."
msgstr ""
"Error de desactivación de la licencia. Por favor, inténtalo de nuevo más "
"tarde o contácta con soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/LicenseDisabledException.php:28
msgid "This license is currently disabled. Please contact support for help."
msgstr ""
"Esta licencia está actualmente desactivada. Por favor, contácta con soporte "
"para obtener ayuda."

#: src/Domain/Plugin/Exception/LicenseExpiredException.php:28
msgid "This license has expired. Please contact support to renew it."
msgstr ""
"Esta licencia está caducada. Por favor, contácta con soporte para renovarla."

#: src/Domain/Plugin/Exception/LicenseInvalidException.php:28
msgid ""
"This license key is not authorized for this plugin. Please verify your "
"license key or contact support for help."
msgstr ""
"Esta clave de licencia no está autorizada para este plugin. Por favor, "
"verifica tu clave de licencia o contácta con soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/LicenseInvalidItemIdException.php:28
msgid ""
"This license cannot be used for this plugin. Please contact support for help."
msgstr ""
"Esta licencia no se puede usar con este plugin. Por favor, contácta con "
"soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/LicenseInvalidItemNameException.php:28
msgid ""
"This license does not match the plugin you are trying to activate. Please "
"contact support for assistance."
msgstr ""
"Esta licencia no se coincide con el plugin que intentas activar. Por favor, "
"contácta con soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/LicenseKeyMismatchException.php:28
msgid ""
"License key does not match our records. Please contact support for "
"assistance."
msgstr ""
"La clave de licencia no coincide con nuestros registros. Por favor, contácta "
"con soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/LicenseMissingException.php:28
msgid "No license key provided. Please enter a valid license key."
msgstr ""
"No se ha proporcionado ninguna clave de licencia. Por favor, introduce una "
"clave de licencia válida."

#: src/Domain/Plugin/Exception/LicenseMissingUrlException.php:28
msgid ""
"Your site URL is required to activate the license. Please enter a valid site "
"URL to continue."
msgstr ""
"El URL de tu sitio es obligatoria para activar la licencia. Introduce una "
"URL válida para continuar."

#: src/Domain/Plugin/Exception/LicenseNoActivationsLeftException.php:28
msgid ""
"License activation limit reached. Please contact support to upgrade or "
"deactivate on another site."
msgstr ""
"Se ha alcanzado el límite de activación de la licencia. Ponte en contacto "
"con soporte para actualizar o desactivar en otro sitio."

#: src/Domain/Plugin/Exception/LicenseNotActivableException.php:28
msgid "This license cannot be activated. Please contact support for help."
msgstr ""
"Esta licencia no se puede activar. Por favor, contácta con soporte para "
"obtener ayuda."

#: src/Domain/Plugin/Exception/LicenseServerException.php:28
msgid ""
"License server error. Please try again later or contact support for help."
msgstr ""
"Error del servidor de licencias. Por favor, inténtalo de nuevo más tarde o "
"contácta con soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/LicenseServerInvalidResponseException.php:28
msgid ""
"The license server returned an invalid response. Please try again later or "
"contact support for help."
msgstr ""
"El servidor de licencias ha devuelto una respuesta no válida. Por favor, "
"inténtalo de nuevo más tarde o contácta con soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/LicenseSiteInactiveException.php:28
msgid ""
"This license is inactive for this site. Please contact support for help."
msgstr ""
"Esta licencia está inactiva para este sitio. Por favor, contácta con soporte "
"para obtener ayuda."

#: src/Domain/Plugin/Exception/PluginActivationException.php:29
msgid ""
"Plugin activation failed. Please try again later or contact support for help."
msgstr ""
"Fallo en la activación del plugin. Por favor, inténtalo de nuevo más tarde o "
"contácta con soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/PluginAlreadyInstalledException.php:29
msgid "This action is not possible because the plugin is already installed."
msgstr "Esta acción no es posible porque el plugin ya está instalado."

#: src/Domain/Plugin/Exception/PluginDeactivationException.php:29
msgid ""
"Plugin deactivation failed. Please try again later or contact support for "
"help."
msgstr ""
"Fallo en la desactivación del plugin. Por favor, inténtalo de nuevo más "
"tarde o contácta con soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/PluginFamilyNotFoundException.php:29
msgid "Plugin family not found. Please contact support for help."
msgstr ""
"Familia de plugin no encontrada. Por favor, contácta con soporte para "
"obtener ayuda."

#: src/Domain/Plugin/Exception/PluginFreeProConflictException.php:29
msgid ""
"This action is not possible because both free and pro versions are "
"installed. Please uninstall one version to continue."
msgstr ""
"Esta acción no es posible porque están instaladas ambas versiones, la "
"gratuita y la Pro. Desinstala una de las versiones para continuar."

#: src/Domain/Plugin/Exception/PluginInstallException.php:29
msgid "Plugin installation failed. Please contact support for help."
msgstr ""
"Fallo en la instalación del plugin. Por favor, inténtalo de nuevo más tarde "
"o contácta con soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/PluginNotActivatedException.php:29
msgid ""
"This action is not possible because the plugin is not activated. Please "
"activate the plugin and try again."
msgstr ""
"Esta acción no es posible porque el plugin no está activado. Por favor, "
"activa el plugin e inténtalo de nuevo."

#: src/Domain/Plugin/Exception/PluginNotFoundException.php:29
msgid ""
"Plugin not found in our available plugins list. Please contact support for "
"help."
msgstr ""
"Plugin no encontrado en nuestra lista de plugins disponibles. Por favor, "
"contácta con soporte para obtener ayuda."

#: src/Domain/Plugin/Exception/PluginNotInstalledException.php:29
msgid ""
"This action is not possible because the plugin is not installed. Please "
"install the plugin and try again."
msgstr ""
"Esta acción no es posible porque el plugin no está instalado. Por favor, "
"instala el plugin e inténtalo de nuevo."

#: src/Domain/Plugin/Exception/UnknownLicenseServerException.php:28
msgid ""
"Unknown license server error. Please try again later or contact support for "
"help."
msgstr ""
"Error desconocido del servidor de licencias. Por favor, inténtalo de nuevo "
"más tarde o contácta con soporte para obtener ayuda."

