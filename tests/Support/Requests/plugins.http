### Variables for environment
@baseUrl = http://localhost:8032/wp-json
@apiPath = publishpress-hub/v1
# Replace these with your credentials - use base64 encoded credentials (username:appPassword), get from the .env file after starting the test containers.
@passwordHash = YWRtaW46ZEkwS3hzeDlnUEd5VlZ6MDllcWowQ1VU
@licenseKey = b7dfdc0b0ebc6cc49561023e57c58c56

### Test WordPress REST API (no auth required)
GET {{baseUrl}}
Accept: application/json

### Get Plugins
GET {{baseUrl}}/{{apiPath}}/plugins
Accept: application/json
Content-Type: application/json
Authorization: Basic {{passwordHash}}

### Try to install plugin with invalid slug
POST {{baseUrl}}/{{apiPath}}/plugins/invalid-slug/install/free
Accept: application/json
Content-Type: application/json
Authorization: Basic {{passwordHash}}

### Try to install plugin that is already installed
POST {{baseUrl}}/{{apiPath}}/plugins/publishpress-authors/install/free
Accept: application/json
Content-Type: application/json
Authorization: Basic {{passwordHash}}

### Install Free Plugin
POST {{baseUrl}}/{{apiPath}}/plugins/publishpress-checklists/install/free
Accept: application/json
Content-Type: application/json
Authorization: Basic {{passwordHash}}

### Install Pro Plugin
POST {{baseUrl}}/{{apiPath}}/plugins/publishpress-checklists/install/pro
Accept: application/json
Content-Type: application/json
Authorization: Basic {{passwordHash}}

{
    "licenseKey": "{{licenseKey}}"
}
