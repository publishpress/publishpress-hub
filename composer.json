{
    "name": "publishpress/publishpress-hub",
    "version": "1.0.2",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "description": "PublishPress Hub",
    "authors": [
        {
            "name": "PublishPress",
            "email": "help@publishpress.com",
            "homepage": "https://publishpress.com",
            "role": "Developer"
        }
    ],
    "extra": {
        "generator":{
            "namespace": "PublishPress\\Hub",
            "lib-class-test": "class_exists('PublishPress\\Hub\\Infrastructure\\Container\\DependencyContainer')",
            "action-initialize-priority": "-240",
            "action-register-priority": "-250",
            "src-dir": "src",
            "generate-test-file": false
        },
        "version-constant": "PUBLISHPRESS_HUB_VERSION",
        "plugin-slug": "publishpress-hub",
        "plugin-name": "publishpress-hub",
        "plugin-folder": "publishpress-hub",
        "plugin-lang-domain": "publishpress-hub",
        "plugin-github-repo": "publishpress/publishpress-hub",
        "plugin-composer-package": "publishpress/publishpress-hub"
    },
    "autoload": {
        "files": [
            "src/include.php"
        ]
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "publishpress/dev-workspace": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "automattic/jetpack-autoloader": true,
            "php-http/discovery": true
        },
        "process-timeout": 0
    },
    "prefer-stable": true,
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "publishpress/dev-workspace": "dev-development"
    }
}
