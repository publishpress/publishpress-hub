{
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "vendor-dir": "vendor",
        "preferred-install": {
            "*": "dist"
        },
        "platform-check": false,
        "autoloader-suffix": "PublishPressHub"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "publishpress/psr-container": "^2.0",
        "woocommerce/action-scheduler": "^3.7",
        "publishpress/wordpress-edd-license": "^3.0"
    }
}
