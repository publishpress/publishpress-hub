{
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "vendor-dir": "vendor",
        "preferred-install": {
            "*": "dist"
        },
        "platform-check": false,
        "autoloader-suffix": "PublishPressHub"
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "publishpress/psr-container": "^2.0",
        "woocommerce/action-scheduler": "^3.7",
        "alledia/edd-sl-plugin-updater": "^1.6"
    }
}
