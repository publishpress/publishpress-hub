│   │   └── Logger/
│   │       └── ThrowableErrorLogger.php  # WordPress implementation
│   ├── Database/
│   ├── External/
│   ├── Container/
│   │   └── ServiceContainer.php     # DI Container
│   ├── Contracts/
│   │   └── LoggerInterface.php      # Infrastructure contracts
│   ├── HooksList.php                # Abstract list of infrastructure hooks
│   └── ServicesList.php             # Abstract list of infrastructure service names
├── Presentation/
│   ├── Admin/
